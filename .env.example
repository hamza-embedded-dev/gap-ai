# ==============================================================================
# Active Backend Configuration (consumed by backend/app/config.py)
# ==============================================================================

# Runtime environment: development, test, or production
ENVIRONMENT=development

# Access token hashing: appended to raw bearer tokens before SHA-256 hashing.
# Production requires at least 32 characters. Development allows a dummy secret.
TOKEN_HASH_PEPPER=

# Database: Supabase PostgREST API (service key is backend-only: never ship it to web or firmware)
# Required when connecting to a live Supabase instance; optional for offline/mock development.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# CORS: Allowed origins for Web client (comma-separated list, JSON array, or * without credentials)
# Example: http://localhost:3000,http://localhost:5173 or ["http://localhost:3000"]
ALLOWED_ORIGINS=

# Nebius Token Factory (consumed by backend/app/ai/llm.py)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning
MODEL_SUPER=nvidia/Nemotron-3_5-Lightning
NEBIUS_TIMEOUT_SECONDS=30

# Groq: speech-to-text (backend/app/ai/stt.py) and text-to-speech (backend/app/ai/tts.py)
GROQ_API_KEY=
STT_PROVIDER=groq
STT_MODEL=whisper-large-v3

# Spoken device reply: POST /voice returns audio/wav when the client sends Accept: audio/wav.
# Groq currently lists Orpheus TTS for English (canopylabs/orpheus-v1-english) and Saudi Arabic
# (canopylabs/orpheus-arabic-saudi) only; Turkish reply text read by the English model sounds accented.
# Set TTS_ENABLED=false to always answer with JSON only.
TTS_ENABLED=true
TTS_MODEL=canopylabs/orpheus-v1-english
TTS_VOICE=troy
TTS_TIMEOUT_SECONDS=10

# ==============================================================================
# Future Integration Variables (reserved; not yet consumed by backend code)
# ==============================================================================

# Nebius alternative model tiers (optional)
MODEL_NANO=
MODEL_ULTRA=


# External tools
WEATHER_API_KEY=
TAVILY_API_KEY=

# App
APP_BASE_URL=
DEMO_SESSION_TTL_HOURS=24
MAX_AUDIO_SECONDS=10
