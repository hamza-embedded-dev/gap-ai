# ==============================================================================
# GAP-AI Web - Environment Variables (.env.example)
# ==============================================================================

# Backend API base URL (defaults to '/api' for Vite dev proxy)
# Production Netlify: https://gap-ai-backend.onrender.com (example)
VITE_API_URL=

# Supabase Auth Configuration (Google Provider)
# Public Anon Key and URL are safe to expose to browser clients
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
