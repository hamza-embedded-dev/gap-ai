{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GAP AI Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intent",
    "title",
    "category",
    "date",
    "time",
    "recurrence",
    "needs_weather_check",
    "confidence"
  ],
  "properties": {
    "intent": {
      "type": "string",
      "enum": [
        "create_plan",
        "update_plan",
        "reschedule_plan",
        "complete_plan",
        "postpone_plan",
        "skip_plan",
        "query"
      ]
    },
    "title": {
      "type": "string"
    },
    "category": {
      "type": ["string", "null"]
    },
    "date": {
      "type": ["string", "null"],
      "format": "date"
    },
    "time": {
      "type": ["string", "null"],
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "recurrence": {
      "type": ["string", "null"]
    },
    "needs_weather_check": {
      "type": "boolean"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
