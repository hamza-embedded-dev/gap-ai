{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ParsedPlan",
  "description": "Single source of truth for the AI output. Prompts, test set, backend validation and web types must all follow this file.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intent",
    "title",
    "category",
    "date",
    "time",
    "duration_minutes",
    "recurrence",
    "language",
    "needs_weather_check",
    "clarification_question",
    "confidence"
  ],
  "properties": {
    "intent": {
      "enum": ["create_plan", "clarify", "unsupported"]
    },
    "title": {
      "type": ["string", "null"]
    },
    "category": {
      "type": ["string", "null"],
      "enum": [
        "sport",
        "study",
        "work",
        "meeting",
        "health",
        "social",
        "personal",
        "other",
        null
      ]
    },
    "date": {
      "type": ["string", "null"],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "time": {
      "type": ["string", "null"],
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
    },
    "duration_minutes": {
      "type": ["integer", "null"],
      "minimum": 5,
      "maximum": 1440
    },
    "recurrence": {
      "type": ["string", "null"],
      "description": "RRULE subset, e.g. FREQ=WEEKLY;BYDAY=TU"
    },
    "language": {
      "enum": ["tr", "en"]
    },
    "needs_weather_check": {
      "type": "boolean"
    },
    "clarification_question": {
      "type": ["string", "null"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "intent": {
            "const": "create_plan"
          }
        },
        "required": ["intent"]
      },
      "then": {
        "properties": {
          "title": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "time": {
            "type": "string"
          },
          "clarification_question": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "intent": {
            "const": "clarify"
          }
        },
        "required": ["intent"]
      },
      "then": {
        "properties": {
          "clarification_question": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "intent": {
            "const": "unsupported"
          }
        },
        "required": ["intent"]
      },
      "then": {
        "properties": {
          "title": {
            "type": "null"
          },
          "category": {
            "type": "null"
          },
          "date": {
            "type": "null"
          },
          "time": {
            "type": "null"
          },
          "duration_minutes": {
            "type": "null"
          },
          "recurrence": {
            "type": "null"
          },
          "needs_weather_check": {
            "const": false
          },
          "clarification_question": {
            "type": "null"
          }
        }
      }
    }
  ]
}
